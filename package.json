{
  "name": "app-tela-comercial",
  "version": "1.0.0",
  "private": true,
  "description": "Tela Comercial em React + TypeScript com API Express/SQL Server",
  "main": "src/server/server.ts",
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/server.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "start": "tsx src/server/server.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck",
    "preview": "vite preview --host 0.0.0.0",
    "test:catalogo": "node --import tsx --test src/modulos/comercial/catalogo.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "mssql": "^10.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
